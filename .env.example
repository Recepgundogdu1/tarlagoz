# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env dosyasını ASLA git'e göndermeyin (.gitignore içinde olmalı).

# --- Firebase (Firebase Console > Proje ayarları > Uygulamalarınız > Web uygulaması) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Görsel yapay zekâ (hastalık tespiti ve fiş okuma) ---
# OpenAI uyumlu bir "chat completions" adresi bekler.
# Boş bırakırsanız uygulama DEMO modunda çalışır ve örnek sonuç gösterir.
# Örnek: AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_URL=
AI_API_KEY=
AI_MODEL=
